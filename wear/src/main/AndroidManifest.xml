<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="koppter"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <!-- The agenda comes from the phone application: without it, this application shows nothing. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />
        <!-- [impl->dsn~watch-data-layer~1] -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- [impl->dsn~watch-tile~1] -->
        <service
            android:name=".AgendaTileService"
            android:exported="true"
            android:label="koppter"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <!-- What the list of tiles shows of this one. -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>
        <!-- Exported for Google Play services, which tell of a new agenda; the service takes that from no other sender. -->
        <service
            android:name=".AgendaListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:path="/koppter/agenda"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
